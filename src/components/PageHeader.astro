---
interface Props { title: string; eyebrow?: string; lead?: string }
const { title, eyebrow, lead } = Astro.props
---
<header class="site-container page-header">
  {eyebrow && <p class="site-eyebrow">{eyebrow}</p>}
  <h1 class="site-display">{title}</h1>
  {lead && <p class="site-lead">{lead}</p>}
  <slot />
</header>
<style>
  .page-header { display: flex; flex-direction: column; gap: var(--space-4); padding-block: var(--space-16) var(--space-10); }
  @media (min-width: 768px) { .page-header { padding-block: var(--space-24) var(--space-12); } }
</style>
