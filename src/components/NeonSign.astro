---
// The home hero's neon sign (design system: NeonSign). Decorative: the page must also have a real <h1>.
---
<div class="np-sign np-sign--beon" data-np-sign aria-hidden="true">
  <div class="np-sign__board">
    <span class="np-sign__lit np-sign__row np-sign__row--top" data-text="NEON">NEON</span>
    <span class="np-sign__lit np-sign__row np-sign__row--mid" data-text="PURPLE">PURP<span class="np-sign__flicker--uneven">L</span>E</span>
    <span class="np-sign__studio"><span class="np-sign__lit" data-text="studio">studio</span></span>
  </div>
</div>
