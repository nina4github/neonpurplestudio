---
import BaseLayout from "../../layouts/BaseLayout.astro"
import PageHeader from "../../components/PageHeader.astro"
import PostList from "../../components/PostList.astro"
import { getPosts } from "../../lib/content"
import { url } from "../../lib/url"
import { SITE } from "../../site.config"
const posts = await getPosts()
---
<BaseLayout title="Writing" description="Notes on product, accessibility, design systems and building with AI.">
  <PageHeader title="Writing" lead="Notes on product, accessibility, design systems and building with AI." />
  <section class="site-container writing" aria-label="Posts">
    {posts.length > 0 ? (
      <PostList posts={posts} />
    ) : (
      <p class="site-lead">The first posts are being written. Meanwhile, my half-finished thinking lives on <a class="np-link np-link--external" href={SITE.ideasUrl}>In the corner<span class="np-visually-hidden"> (notes site)</span></a>.</p>
    )}
    <p class="writing__rss"><a class="np-link" href={url("/rss.xml")}>Follow with RSS</a></p>
  </section>
</BaseLayout>
<style>
  .writing { padding-bottom: var(--space-24); display: flex; flex-direction: column; gap: var(--space-10); }
</style>
