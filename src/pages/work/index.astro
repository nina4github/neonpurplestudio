---
import BaseLayout from "../../layouts/BaseLayout.astro"
import PageHeader from "../../components/PageHeader.astro"
import ProjectCard from "../../components/ProjectCard.astro"
import { getProjects } from "../../lib/content"
const projects = await getProjects()
---
<BaseLayout title="Work" description="Selected projects: accessibility programs, design systems, platform product and AI prototyping.">
  <PageHeader title="Work" lead="Selected projects, told as problem, contribution and outcome." />
  <section class="site-container work-list" aria-label="Projects">
    {projects.length > 0 ? (
      <div class="site-grid">{projects.map((p) => <ProjectCard project={p} headingLevel="h2" />)}</div>
    ) : (
      <p class="site-muted">Projects are on their way.</p>
    )}
  </section>
</BaseLayout>
<style>.work-list { padding-bottom: var(--space-24); }</style>
