---
import { render } from "astro:content"
import BaseLayout from "../layouts/BaseLayout.astro"
import PageHeader from "../components/PageHeader.astro"
import PullQuote from "../components/PullQuote.astro"
import { getPage } from "../lib/content"
import { url } from "../lib/url"
const about = await getPage("about")
const home = await getPage("home")
const { Content } = await render(about)
const beliefs = home.data.beliefs ?? []
---
<BaseLayout title={about.data.title} description={about.data.description}>
  <PageHeader title="About" eyebrow="Elena Nazzi · Founder" />
  <section class="site-container about">
    <div class="site-prose"><Content /></div>
    {beliefs.length > 0 && (
      <aside class="about__beliefs" aria-label="What I believe">
        {beliefs.map((b) => <PullQuote text={b} />)}
      </aside>
    )}
    <p><a class="np-btn np-btn--primary" href={url("/contact/")}>Let's talk</a></p>
  </section>
</BaseLayout>
<style>
  .about { display: flex; flex-direction: column; gap: var(--space-16); padding-bottom: var(--space-24); }
  .about__beliefs { display: grid; gap: var(--space-12) var(--space-10); grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
</style>
